(defvar weather_icon "04n")

(defpoll weather-json
  :interval "1s" 
  :initial "{}"
  :run-while true
`~/.config/eww/scripts/get_weather.sh`)

(defpoll time
  :interval "1s"
  :initial: "hehe"
  :run-while true
`date +"%I:%M %p"`)

(defpoll date
  :interval "1s"
  :initial: "hehe"
  :run-while true
`date +"%A, %B\ %e"`)

(defwindow weather
  :monitor '["<primary>", 0]'
  :hexpand true
  :geometry (geometry
    :x "24px"
    :y "48px"
    :height "200px"
    :anchor "top left"
  )
  :stacking "bg"
  :windowtype "dock"
  :wm-ignore true
(weather-widget))


(defwidget weather-widget []
  (box
    :valign 'center'
    :spacing 24
    :orientation 'h'
    (box
      :orientation "v"
      :class "time-date-box"
      (label
        :class "time"
        :text "${time}"
        :xalign 1
      )
      (label
        :xalign 1
        :class "date"
        :text "${date}"
      )
    )
    (centerbox
      :orientation "vertical"
      (label
        :class "temp"
        :text "${weather-json?.main?.temp}°F"
        :xalign 0
      )
      (label
        :class "feels_like"
        :text 'feels like ${weather-json?.main?.feels_like}°F'
        :xalign 0
      )
      (label
        :class "condition"
        :text '${weather-json?.weather?.[0]?.description}'
        :xalign 0
      )
    )
  )
)
