(defwindow calendar
  :monitor '["<primary>", 0]'
  :geometry (geometry
    :x "24px"
    :y "324px"
    :width "600px"
    :height "420px"
    :anchor "top left"
  )
  :stacking "bg"
  :windowtype "dock"
  :wm-ignore true
  (calendar-widget)
)

(defwidget calendar-widget []
  (box
    :halign 'center'
    :valign 'center'
    (calendar)
  )
)
